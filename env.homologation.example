# Exemplo de variáveis para o serviço de homologação.
# Injete ARGOS_SECRET_KEY e ARGOS_DB_PASSWORD pelo cofre/ambiente do serviço;
# não grave valores reais neste arquivo nem o carregue automaticamente.
DJANGO_SETTINGS_MODULE=config.settings_homologation
ARGOS_DEBUG=false
ARGOS_ALLOWED_HOSTS=argos-hom.exemplo.interno
ARGOS_CSRF_TRUSTED_ORIGINS=https://argos-hom.exemplo.interno
ARGOS_SECURE_SSL_REDIRECT=true
ARGOS_SECURE_HSTS_PRELOAD=false
ARGOS_TRUST_PROXY_SSL_HEADER=false

ARGOS_DB_NAME=argos_hom_db
ARGOS_DB_USER=argos_hom_app
ARGOS_DB_HOST=127.0.0.1
ARGOS_DB_PORT=5432
ARGOS_DB_CONN_MAX_AGE=60
