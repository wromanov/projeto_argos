# Não carregado automaticamente. Valores reais devem vir do sistema ou cofre.
ARGOS_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LONGA_E_ALEATORIA
ARGOS_DEBUG=false
ARGOS_ALLOWED_HOSTS=argos.exemplo.interno
ARGOS_CSRF_TRUSTED_ORIGINS=https://argos.exemplo.interno
ARGOS_SECURE_SSL_REDIRECT=true
ARGOS_SECURE_HSTS_SECONDS=31536000
ARGOS_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# HSTS preload exige avaliação prévia.
ARGOS_SECURE_HSTS_PRELOAD=false
# Confie no proxy SSL somente quando controlado pela organização.
ARGOS_TRUST_PROXY_SSL_HEADER=false
